"<div class=\"loader-bg\" #loaderBg>\n  <!-- Background Grid lines for high-tech HUD feel -->\n  <div class=\"loader-grid\"></div>\n  <div class=\"loader-glow-radial\"></div>\n\n  <!-- Shutter Blades (Cover the screen diagonally, slides out) -->\n  <div class=\"shutter-blades\">\n    <div class=\"shutter-blade blade-top\">\n      <svg class=\"blade-border\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n        <path d=\"M 0 0 L 50 50 L 100 0\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.25)\" stroke-width=\"0.75\" />\n      </svg>\n    </div>\n    <div class=\"shutter-blade blade-right\">\n      <svg class=\"blade-border\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n        <path d=\"M 100 0 L 50 50 L 100 100\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.25)\" stroke-width=\"0.75\" />\n      </svg>\n    </div>\n    <div class=\"shutter-blade blade-bottom\">\n      <svg class=\"blade-border\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n        <path d=\"M 100 100 L 50 50 L 0 100\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.25)\" stroke-width=\"0.75\" />\n      </svg>\n    </div>\n    <div class=\"shutter-blade blade-left\">\n      <svg class=\"blade-border\" viewBox=\"0 0 100 100\" preserveAspectRatio=\"none\">\n        <path d=\"M 0 100 L 50 50 L 0 0\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.25)\" stroke-width=\"0.75\" />\n      </svg>\n    </div>\n  </div>\n\n  <!-- Central Concentric Ring & Monogram Assembly -->\n  <div class=\"loader-center-assembly\" #centerAssembly>\n    <div class=\"hologram-container\">\n      <svg class=\"hologram-svg\" viewBox=\"0 0 160 160\">\n        <!-- Outer dotted rotating ring -->\n        <circle class=\"circle-outer\" cx=\"80\" cy=\"80\" r=\"75\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.15)\" stroke-width=\"1\" stroke-dasharray=\"3 6\" />\n        \n        <!-- Middle segmented rotating ring -->\n        <circle class=\"circle-middle\" cx=\"80\" cy=\"80\" r=\"66\" fill=\"none\" stroke=\"rgba(197, 168, 128, 0.3)\" stroke-width=\"1.5\" 
