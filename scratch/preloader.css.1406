".loader-bg {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  z-index: 99999;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  background-color: #050508;\n}\n\n/* Background high-tech styling */\n.loader-grid {\n  position: absolute;\n  inset: 0;\n  background-image: \n    linear-gradient(rgba(197, 168, 128, 0.015) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(197, 168, 128, 0.015) 1px, transparent 1px);\n  background-size: 50px 50px;\n  background-position: center;\n  z-index: 0;\n  pointer-events: none;\n}\n\n.loader-glow-radial {\n  position: absolute;\n  inset: 0;\n  background: radial-gradient(circle at center, rgba(197, 168, 128, 0.04) 0%, rgba(5, 5, 8, 0) 75%);\n  z-index: 0;\n  pointer-events: none;\n}\n\n/* Shutter Blades */\n.shutter-blades {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  z-index: 1;\n  pointer-events: none;\n}\n\n.shutter-blade {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background-color: #050508;\n  will-change: transform;\n}\n\n.blade-top {\n  clip-path: polygon(0 0, 50% 50%, 100% 0);\n}\n\n.blade-right {\n  clip-path: polygon(100% 0, 50% 50%, 100% 100%);\n}\n\n.blade-bottom {\n  clip-path: polygon(100% 100%, 50% 50%, 0 100%);\n}\n\n.blade-left {\n  clip-path: polygon(0 100%, 50% 50%, 0 0);\n}\n\n.blade-border {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  opacity: 0.22;\n  pointer-events: none;\n}\n\n/* Central Assembly */\n.loader-center-assembly {\n  position: relative;\n  z-index: 2;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 36px;\n  width: 100%;\n  max-width: 360px;\n  will-change: opacity, transform;\n}\n\n/* Hologram container */\n.hologram-container {\n  position: relative;\n  width: 180px;\n  height: 180px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.hologram-svg {\n  width: 100%;\n  height: 100%;\n}\n\n.circle-out
